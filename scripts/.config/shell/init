# Source this from .bashrc or .zshrc with:
#   [ -f "$HOME/.config/shell/init" ] && . "$HOME/.config/shell/init"

# ---------- Mise (multi-tool version manager) ----------
export MISE_YES=1  # auto-confirm mise operations
if command -v mise &>/dev/null; then
  eval "$(mise activate bash)"
fi

# ---------- Starship prompt ----------
export STARSHIP_CONFIG="$HOME/.config/starship.toml"
if command -v starship &>/dev/null; then
  eval "$(starship init bash)"
fi

# ---------- Carapace (multi-shell completion engine) ----------
if command -v carapace &>/dev/null; then
  if [ -n "$BASH_VERSION" ]; then
    eval "$(carapace _carapace bash)"
  elif [ -n "$ZSH_VERSION" ]; then
    source <(carapace _carapace zsh)
  fi
fi

# ---------- Fzf (fuzzy finder) ----------
if command -v fzf &>/dev/null; then
  if [ -n "$BASH_VERSION" ]; then
    eval "$(fzf --bash 2>/dev/null)"
  elif [ -n "$ZSH_VERSION" ]; then
    source <(fzf --zsh 2>/dev/null)
  fi
fi

# ---------- Load additional configs --------
# load secrets like API keys
[ -f ~/.secrets.sh ] && . ~/.secrets.sh

# load claude code config
. ~/.config/shell/claude-env.sh
